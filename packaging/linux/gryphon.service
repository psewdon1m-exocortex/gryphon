[Unit]
Description=Exocortex Gryphon Telegram gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gryphon
Group=gryphon-clients
Environment=NODE_ENV=production
Environment=GRYPHON_DATA_DIR=/var/lib/gryphon
Environment=GRYPHON_PUBLIC_HOST=127.0.0.1
Environment=GRYPHON_PUBLIC_PORT=18380
Environment=GRYPHON_ADMIN_SOCKET=/run/gryphon/admin.sock
Environment=GRYPHON_CLIENT_SOCKET=/run/gryphon/client.sock
EnvironmentFile=-/etc/gryphon/gryphon.env
ExecStart=/usr/bin/node /usr/local/lib/gryphon/app/dist/main.js
Restart=on-failure
RestartSec=2s
StateDirectory=gryphon
StateDirectoryMode=0700
RuntimeDirectory=gryphon
RuntimeDirectoryMode=0770
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
