GRYPHON_DATA_DIR=/var/lib/gryphon
GRYPHON_PUBLIC_ORIGIN=https://telegram.example.com
GRYPHON_PUBLIC_HOST=0.0.0.0
GRYPHON_PUBLIC_PORT=18380
GRYPHON_ADMIN_SOCKET=/run/gryphon/admin.sock
GRYPHON_CLIENT_SOCKET=/run/gryphon/client.sock
GRYPHON_CLIENTS_GID=1000
TELEGRAM_API_BASE_URL=https://api.telegram.org/
TELEGRAM_PROVIDER_TIMEOUT_MS=10000
TELEGRAM_WEBHOOK_MAX_BYTES=65536
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=8
